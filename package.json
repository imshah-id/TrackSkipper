{
  "name": "trackskipper",
  "displayName": "Git Replay",
  "description": "Replay Git changes in an isolated, timed workspace inside VS Code.",
  "version": "0.2.0",
  "publisher": "trackskipper-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "gitReplay.open",
        "title": "Git Replay: Open",
        "icon": "$(play)"
      }
    ],
    "configuration": {
      "title": "Git Replay",
      "properties": {
        "gitReplay.storageQuotaMiB": {
          "type": "integer",
          "default": 1024,
          "minimum": 16,
          "maximum": 20480,
          "scope": "application",
          "description": "Maximum storage for the replay session, in MiB."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitReplay",
          "title": "Git Replay",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "gitReplay": [
        {
          "id": "gitReplay.launcher",
          "name": "Git Replay",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitReplay.launcher",
        "contents": "Replay committed changes in an isolated workspace.\n[Open Git Replay](command:gitReplay.open)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitReplay.open",
          "when": "view == gitReplay.launcher",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.cjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out trackskipper.vsix",
    "test:ui": "npm run build && node scripts/panel-smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "3.6.0",
    "typescript": "5.8.3"
  }
}
